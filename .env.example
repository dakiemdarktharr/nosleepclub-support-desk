# Local synthetic demo; leave all secrets blank in source control.
AI_PROVIDER="mock"
AI_MODEL="gpt-6-luna"
# Optional; empty inherits AI_MODEL. Hosted web search uses the same bounded budget.
AI_CONVERSATION_MODEL=""
AI_WEB_MODEL="gpt-4.1"
AI_WEB_SEARCH="false"
OPENAI_API_KEY=""
# Shared maximum model calls per UTC day; defaults to 20 and is capped at 50.
AI_MAX_ATTEMPTS="20"
SUPPORT_STORAGE="memory-demo"
SUPPORT_ACCESS_MODE="public-demo"
SUPPORT_VERIFY_FAULTS="true"
MONGODB_URI=""
MONGODB_DB="mlai26_support_v3_demo"
# Identity uses a separate database; blank URI inherits MONGODB_URI.
# Requires Mongo transactions (replica set); no memory/CSV account fallback.
IDENTITY_MONGODB_URI=""
IDENTITY_MONGODB_DB="vng_support_identity"
ENVIRONMENT="development"
