# Local synthetic demo; leave all secrets blank in source control.
AI_PROVIDER="mock"
AI_MODEL=""
# Optional local sentiment inference through Ollama; set to ollama to enable.
AI_SENTIMENT_PROVIDER="rules"
AI_SENTIMENT_MODEL="qwen3.5:4b"
AI_SENTIMENT_TIMEOUT_MS="25000"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
# Optional; empty inherits AI_MODEL. Hosted web search uses the same bounded budget.
AI_CONVERSATION_MODEL=""
AI_WEB_MODEL="gpt-4.1"
AI_WEB_SEARCH="false"
OPENAI_API_KEY=""
AI_MAX_ATTEMPTS="20"
SUPPORT_STORAGE="memory-demo"
SUPPORT_ACCESS_MODE="public-demo"
SUPPORT_VERIFY_FAULTS="true"
MONGODB_URI=""
MONGODB_DB="mlai26_support_v3_demo"
ENVIRONMENT="development"
